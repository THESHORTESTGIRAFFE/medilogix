# MediLogix Production Environment Variables
# COPY THIS FILE TO .env AND FILL IN THE REAL VALUES

# Security
SECRET_KEY=generate-a-long-random-string-here
FLASK_APP=run.py
FLASK_ENV=production

# Database
MYSQL_HOST=localhost
MYSQL_USER=your_production_user
MYSQL_PASSWORD=your_production_password
MYSQL_DB=medilogix_prod

# Mail (Optional but recommended)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_DEFAULT_SENDER=noreply@medilogix.com
